DEEPSEEK_API_KEY=
# Exact DeepSeek model name; part of the parse-cache key. Accepted names (checked 2026-11-17): deepseek-flash, deepseek-v4-pro
# Chosen: deepseek-flash (cheaper)
DEEPSEEK_MODEL=deepseek-flash
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Fixed "today" (YYYY-MM-DD) given to the parser so relative dates like "tomorrow"
# resolve the same way in every simulation run. Defaults to the current UTC date.
# PARSER_REFERENCE_DATE=

# Which clarification policy the chat app uses: K or T. No default (the adopted policy is
# chosen after the experiment). The simulation harness takes --policy instead.
# CLARIFICATION_POLICY=K
# For simulation runs set PARSER_REFERENCE_DATE=2026-11-23 (simulation/fixture.json reference_date);
# run.js refuses to run otherwise.
